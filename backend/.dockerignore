tests/
ruff.toml
pytest.ini
setup.cfg

# Notebooks y documentación
*.ipynb
.ipynb_checkpoints/
DOCUMENTATE.md
README.md

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Docker
Dockerfile
.dockerignore
docker-compose*.yml
