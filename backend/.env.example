# Elastic Cloud and Rerank Model Configuration
ELASTIC_CLOUD_URL=https://your-elastic-cloud-endpoint
ELASTIC_CLOUD_API_KEY=your_elastic_api_key
ELASTIC_RERANK_ENDPOINT=https://your-elastic-cloud-endpoint/_plugins/_ml/_inference/your-rerank-model-id
ELASTIC_RERANK_MODEL_ID=your-rerank-model-id

# Clave SSH para GitHub
GITHUB_SSH_KEY=your_github_ssh_key
GITHUB_REPO=https://github.com/yourusername/yourrepo
GITHUB_TOKEN=your_github_token

# Credenciales AWS existentes
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# OPEN AI API KEY
OpenAI_API_KEY=your_openai_api_key

# Configuración para embeddings con OpenAI directo
OPENAI_EMBEDDING_API_KEY=your_openai_embedding_api_key
OPENAI_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings

# Configuración para RagFlow
RAGFLOW_BASE_URL=http://localhost:80
RAGFLOW_API_KEY=your_ragflow_api_key

# Configuración para Elasticsearch
ELASTICSEARCH_HOST=https://your-elastic-cloud-endpoint
ES_USER=
ES_PASSWORD=
ES_API_KEY=your_elastic_api_key
INDEX_NAME=your_index_name

# Configuración para embeddings con Azure OpenAI
EMBEDDING_ENDPOINT=https://your-azure-openai-endpoint
EMBEDDING_API_KEY=your_azure_openai_api_key

# Configuración para modelos LLM
CEREBRAS_API_KEY=your_cerebras_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_AZURE_ENDPOINT=https://your-azure-endpoint
DEEPSEEK_AZURE_API_KEY=your_azure_api_key
GOOGLE_API_KEY=your_google_api_key
O3MINI_ENDPOINT=https://your-azure-endpoint
O3MINI_API_KEY=your_azure_api_key
GPT4O_NEW_ENDPOINT=https://your-azure-endpoint
GPT4O_NEW_API_KEY=your_azure_api_key
GPT41_ENDPOINT=https://your-azure-endpoint
GPT41_API_KEY=your_azure_api_key
GPT41MINI_ENDPOINT=https://your-azure-endpoint
GPT41MINI_API_KEY=your_azure_api_key
GPT41MINI_MODEL_NAME=gpt-4.1-mini
GPT41MINI_DEPLOYMENT=gpt-4.1-mini
GPT41MINI_API_VERSION=2025-01-01-preview

#AMAZON MODELS
BEDROCK_REGION=us-east-1
BEDROCK_CLAUDE_MODEL_ID=your_bedrock_claude_model_id
BEDROCK_NOVA_PRO_MODEL_ID=your_bedrock_nova_pro_model_id

# Configuración de Azure OpenAI para Phi-4
PHI4_AZURE_ENDPOINT=https://your-azure-endpoint
PHI4_AZURE_API_KEY=your_azure_api_key
PHI4_MODEL=Phi-4

# Para usar la API key de OpenAI directo en terminal:
# export OPENAI_EMBEDDING_API_KEY="your_openai_embedding_api_key"

O4MINI_ENDPOINT=https://your-azure-endpoint
O4MINI_API_KEY=your_azure_api_key

# Configuración de reranking de Elastic Cloud
ELASTIC_RERANK_ENDPOINT=https://your-elastic-cloud-endpoint/_plugins/_ml/_inference/rerank/your-rerank-model-id
ELASTIC_RERANK_MODEL_ID=your-rerank-model-id
