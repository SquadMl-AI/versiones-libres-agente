# Credenciales AWS existentes
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1

# Configuración para RagFlow
RAGFLOW_BASE_URL=http://localhost:80
RAGFLOW_API_KEY=your_ragflow_api_key

# Configuración para Elasticsearch
ELASTICSEARCH_HOST=http://localhost:1200
ES_USER=elastic
ES_PASSWORD=your_es_password
INDEX_NAME=your_index_name

# Configuración para embeddings con Azure OpenAI
EMBEDDING_ENDPOINT=https://your-azure-endpoint
EMBEDDING_API_KEY=your_azure_api_key

# Configuración para modelos LLM
CEREBRAS_API_KEY=your_cerebras_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_AZURE_ENDPOINT=https://your-deepseek-endpoint
DEEPSEEK_AZURE_API_KEY=your_deepseek_api_key
GOOGLE_API_KEY=your_google_api_key
O3MINI_ENDPOINT=https://your-o3mini-endpoint
O3MINI_API_KEY=your_o3mini_api_key
GPT4O_NEW_ENDPOINT=https://your-gpt4o-endpoint
GPT4O_NEW_API_KEY=your_gpt4o_api_key

#AMAZON MODELS
BEDROCK_REGION=us-east-1
BEDROCK_CLAUDE_MODEL_ID=your_bedrock_claude_model_id
BEDROCK_NOVA_PRO_MODEL_ID=your_bedrock_nova_pro_model_id

# Configuración de Azure OpenAI para Phi-4
PHI4_AZURE_ENDPOINT=https://your-phi4-endpoint
PHI4_AZURE_API_KEY=your_phi4_api_key
PHI4_MODEL=Phi-4

# Clave SSH para GitHub
GITHUB_SSH_KEY=your_github_ssh_key

# Configuración para el modelo 04-mini
O4MINI_ENDPOINT=https://your-o4mini-endpoint
O4MINI_API_KEY=your_o4mini_api_key
